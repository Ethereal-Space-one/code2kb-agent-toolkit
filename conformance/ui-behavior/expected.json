{
  "source_sha256": "2bba0f40db96551eb109d88381bd629d7c941c282c4a015bc2220ceb01e8ae42",
  "module_id": "example.ui.controls",
  "facts": [
    {
      "fact_id": "FACT-001",
      "claim": "报送内容去掉首尾空白后为空时，主提交按钮禁用且处理函数直接返回。",
      "anchors": [
        "fixture:ControlBehavior.vue:6-7",
        "fixture:ControlBehavior.vue:32-33"
      ]
    },
    {
      "fact_id": "FACT-002",
      "claim": "正在等待时主提交按钮禁用且显示忙碌，输入框禁用；处理函数的等待守卫阻止再次调用。",
      "anchors": [
        "fixture:ControlBehavior.vue:5-7",
        "fixture:ControlBehavior.vue:32-35"
      ]
    },
    {
      "fact_id": "FACT-003",
      "claim": "内容去除首尾空白后非空且当前未等待时，提交把阶段设为等待、显示正在提交并尝试调用注入函数。",
      "anchors": [
        "fixture:ControlBehavior.vue:32-37"
      ]
    },
    {
      "fact_id": "FACT-004",
      "claim": "注入函数正常返回后，阶段设为成功并显示提交请求已返回；没有服务端保存或最终业务完成证据。",
      "anchors": [
        "fixture:ControlBehavior.vue:37-39"
      ]
    },
    {
      "fact_id": "FACT-005",
      "claim": "注入函数抛出异常后，阶段设为失败、显示提交失败可重试，重试按钮在失败阶段展示。",
      "anchors": [
        "fixture:ControlBehavior.vue:9",
        "fixture:ControlBehavior.vue:40-42"
      ]
    },
    {
      "fact_id": "FACT-006",
      "claim": "重试按钮调用相同处理函数，仍受内容和等待守卫约束；片段没有自动重试循环。",
      "anchors": [
        "fixture:ControlBehavior.vue:9",
        "fixture:ControlBehavior.vue:32-43"
      ]
    },
    {
      "fact_id": "FACT-007",
      "claim": "本地确认区域的提交只打开本地对话框，不调用报送函数。",
      "anchors": [
        "fixture:ControlBehavior.vue:12-16",
        "fixture:ControlBehavior.vue:45-47"
      ]
    },
    {
      "fact_id": "FACT-008",
      "claim": "本地对话框的关闭按钮只把对话框开关设为关闭，没有取消请求或回滚操作。",
      "anchors": [
        "fixture:ControlBehavior.vue:15-17",
        "fixture:ControlBehavior.vue:48-50"
      ]
    },
    {
      "fact_id": "FACT-009",
      "claim": "对话框开关与报送阶段分别记录；本片段的开关方法不写报送阶段。",
      "anchors": [
        "fixture:ControlBehavior.vue:28-29",
        "fixture:ControlBehavior.vue:45-50"
      ]
    }
  ],
